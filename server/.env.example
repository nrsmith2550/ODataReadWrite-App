# --- App server ---
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Shared password gate for the web UI (replace with real Entra SSO for production)
APP_ACCESS_PASSWORD=change-me

# --- Azure AD (Entra ID) App Registration used for BOTH Microsoft Graph
# and D365 F&O OData, via client-credentials (app-only) flow ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret

# --- Dynamics 365 Finance & Operations ---
# Base org URL, no trailing slash, no /data suffix
D365_ORG_URL=https://yourorg.operations.dynamics.com
# OData entity set name for System Users (verify against /data/$metadata)
D365_SYSTEM_USERS_ENTITY=SystemUsers
# Default company/legal entity (dataAreaId) used for new users
D365_DEFAULT_COMPANY=USMF
# Field on the D365 entity used to detect an existing user
MATCH_FIELD_D365=Email
D365_PAGE_SIZE=500
# Optional: override the default field mapping (see README for details)
# D365_FIELD_MAPPING_JSON={"UserID":"{alias}","Email":"{mail}","Name":"{displayName}","Company":"{defaultCompany}","Enabled":true}

# --- Microsoft Entra ID (Azure AD) source ---
# Optional: restrict to members of a specific group instead of all tenant users
ENTRA_GROUP_ID=
# Entra user field used to detect a match against MATCH_FIELD_D365
MATCH_FIELD_ENTRA=mail
ENTRA_PAGE_SIZE=999
